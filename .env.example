# ── Sarvam AI (ASR + TTS) ────────────────────────────────────────
SARVAM_API_KEY=

# ── Chat LLM (dialogue agent, extraction, summaries, reward judge) ──
# Any OpenAI-compatible endpoint. Default: Sarvam chat, using your Sarvam key.
# (agentrouter.org does not work: it only serves approved coding-agent clients.)
# DeepSeek direct: LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b-conversations
LLM_API_KEY=

# ── Database ─────────────────────────────────────────────────────
# Postgres (Neon) connection string. Leave empty to use local SQLite (vaaksetu.db).
DATABASE_URL=

# ── Auth (Neon Auth) ─────────────────────────────────────────────
# JWKS of your Neon Auth branch. Leave empty to disable auth locally (single user "local").
NEON_AUTH_JWKS_URL=
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# ── Twilio (outbound calls, optional; call routes are off unless all are set) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URL Twilio can reach (ngrok: check http://localhost:4040 after docker compose up)
PUBLIC_BASE_URL=
NGROK_AUTHTOKEN=

# ── HuggingFace (only for the optional IndicWhisper ASR fallback) ──
HF_TOKEN=
